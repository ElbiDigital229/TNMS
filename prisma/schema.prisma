generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PropertyType {
  FLOOR
  BUILDING
  COMPOUND
}

enum City {
  LAHORE
  ISLAMABAD
}

enum Status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AssetCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
}

enum TaskType {
  COMPLAIN
  MAINTENANCE
  INSPECT
  TASK
}

enum SubTaskType {
  REACTIVE
  PREVENTIVE
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum RecurringType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ScheduleFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum TodoStatus {
  OPEN
  COMPLETED
}

enum NotificationType {
  TICKET_ASSIGNED
  TICKET_REASSIGNED_AWAY
  TICKET_STATUS_CHANGED
  TICKET_COMMENT
  TICKET_CREATED_IN_PROPERTY
  TICKET_EDITED
  TICKET_OVERDUE
  TICKET_DUE_SOON
  TICKET_OVERDUE_ESCALATION
  TICKET_BLOCKED
  TICKET_UNBLOCKED
  ASSET_CONDITION_POOR
  PROPERTY_DEACTIVATED
  USER_ACCOUNT_CHANGED
  USER_PASSWORD_RESET
  USER_STATUS_CHANGED
  USER_NEW_SUBORDINATE
  USER_CREATED_UNDER_YOU
  TICKET_MENTION
}

// ─── RBAC Models ───────────────────────────────────────────

model Role {
  id                  String   @id @default(uuid())
  name                String   @unique
  level               Int
  canAssignToMaxLevel Int?
  isSystemRole        Boolean  @default(false)
  status              Status   @default(ACTIVE)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  module      String
  description String
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserPropertyAssignment {
  id         String   @id @default(uuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  module    String
  entityId  String?
  details   String?
  ipAddress String?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// ─── Core Models ───────────────────────────────────────────

model User {
  id            String   @id @default(uuid())
  username      String   @unique
  passwordHash  String
  fullName      String?
  employeeCode  String?  @unique
  designation   String?
  email         String?  @unique
  phone         String?
  isSuperAdmin  Boolean  @default(false)
  allProperties Boolean  @default(false)
  roleId        String
  role          Role     @relation(fields: [roleId], references: [id])
  status        Status   @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  headOfDepartments   Department[] @relation("DepartmentHead")

  todos               Todo[]
  propertyAssignments  UserPropertyAssignment[]
  auditLogs           AuditLog[]
  notifications       Notification[]
  deviceTokens        DeviceToken[]
  createdTickets      Ticket[]  @relation("TicketCreator")
  assignedTickets     Ticket[]  @relation("TicketAssignee")
  blocksRaised        TicketBlock[] @relation("BlockRaisedBy")
  blocksOnMe          TicketBlock[] @relation("BlockingUser")
  blocksResolved      TicketBlock[] @relation("BlockResolvedBy")
  ticketActivities    TicketActivity[] @relation("ActivityPerformedBy")
  ticketComments      TicketComment[] @relation("CommentAuthor")
  schedulesAssigned   TicketSchedule[] @relation("ScheduleAssignee")
  schedulesCreated    TicketSchedule[] @relation("ScheduleCreator")
}

model AreaGroup {
  id        String     @id @default(uuid())
  city      City       @unique
  groupName String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  properties Property[]
}

model Property {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  type        PropertyType
  description String?
  imagePath   String?
  latitude    Float?
  longitude   Float?
  city        City
  status      Status       @default(ACTIVE)
  areaGroupId String?
  areaGroup   AreaGroup?   @relation(fields: [areaGroupId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  floors          Floor[]
  units           Unit[]
  assets          Asset[]
  tickets         Ticket[]
  userAssignments UserPropertyAssignment[]
  ticketSchedules TicketSchedule[]
}

model Floor {
  id         String   @id @default(uuid())
  name       String
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  status     Status   @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  units  Unit[]
  assets Asset[]
}

model Unit {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  unitType    String?
  description String?
  floorId     String?
  floor       Floor?   @relation(fields: [floorId], references: [id])
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id])
  status      Status   @default(ACTIVE)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets Ticket[]
  ticketSchedules TicketSchedule[]
}

model Asset {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  categoryId        String
  category          AssetCategory  @relation(fields: [categoryId], references: [id])
  unitOfMeasure     String
  quantity          Int            @default(1)
  condition         AssetCondition
  additionalInfo    String?
  floorId           String
  floor             Floor          @relation(fields: [floorId], references: [id])
  propertyId        String
  property          Property       @relation(fields: [propertyId], references: [id])
  serialNumber      String?
  purchaseDate      DateTime?
  imagePath         String?
  qrCode            String
  status            Status         @default(ACTIVE)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  ticketAssets      TicketAsset[]
}

model Ticket {
  id              String        @id @default(uuid())
  ticketNumber    String        @unique
  name            String
  description     String
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id])
  unitId          String
  unit            Unit          @relation(fields: [unitId], references: [id])
  dueDate         DateTime
  taskType        TaskType
  subTaskType     SubTaskType
  categoryId      String
  category        TicketCategory @relation(fields: [categoryId], references: [id])
  priority        Priority
  status          TicketStatus  @default(UNASSIGNED)
  createdById     String?
  createdBy       User?         @relation("TicketCreator", fields: [createdById], references: [id])
  assignedToId    String?
  assignedTo      User?         @relation("TicketAssignee", fields: [assignedToId], references: [id])
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  isRecurring     Boolean       @default(false)
  recurringType   RecurringType?
  recurringDay    Int?
  recurringDueDays Int?
  imagePath       String?
  completedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  assets          TicketAsset[]
  comments        TicketComment[]
  activities      TicketActivity[]
  blocks          TicketBlock[]
}

model TicketAsset {
  id        String @id @default(uuid())
  ticketId  String
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset  @relation(fields: [assetId], references: [id])

  @@unique([ticketId, assetId])
}

model TicketComment {
  id          String    @id @default(uuid())
  ticketId    String
  ticket      Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  content     String
  commenterId String?
  commenter   User?     @relation("CommentAuthor", fields: [commenterId], references: [id])
  editedAt    DateTime?
  createdAt   DateTime  @default(now())
}

model TicketActivity {
  id             String   @id @default(uuid())
  ticketId       String
  ticket         Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  action         String
  details        String?
  performedById  String?
  performedBy    User?    @relation("ActivityPerformedBy", fields: [performedById], references: [id])
  createdAt      DateTime @default(now())
}

model TicketCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets Ticket[]
  ticketSchedules TicketSchedule[]
}

model Department {
  id         String   @id @default(uuid())
  name       String   @unique
  status     Status   @default(ACTIVE)
  headUserId String?
  head       User?    @relation("DepartmentHead", fields: [headUserId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users        User[]
  tickets      Ticket[]
  ticketBlocks TicketBlock[]
  ticketSchedules TicketSchedule[]
}

model TicketBlock {
  id              String       @id @default(uuid())
  ticketId        String
  ticket          Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  blockedById     String
  blockedBy       User         @relation("BlockRaisedBy", fields: [blockedById], references: [id])
  blockingUserId  String?
  blockingUser    User?        @relation("BlockingUser", fields: [blockingUserId], references: [id])
  departmentId    String
  department      Department   @relation(fields: [departmentId], references: [id])
  reason          String
  previousStatus  TicketStatus
  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?        @relation("BlockResolvedBy", fields: [resolvedById], references: [id])
  resolvedNote    String?
  createdAt       DateTime     @default(now())
}

model TicketSchedule {
  id           String             @id @default(cuid())
  name         String
  description  String?
  propertyId   String
  unitId       String?
  categoryId   String?
  departmentId String?
  assignedToId String?
  priority     Priority           @default(MEDIUM)
  taskType     TaskType
  subTaskType  SubTaskType        @default(PREVENTIVE)
  frequency    ScheduleFrequency
  dayOfWeek    Int?               // 0=Sun..6=Sat for WEEKLY
  dayOfMonth   Int?               // 1-31 for MONTHLY/QUARTERLY/YEARLY
  monthOfYear  Int?               // 1-12 for QUARTERLY/YEARLY
  nextRunAt    DateTime
  lastRunAt    DateTime?
  isActive     Boolean            @default(true)
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  property     Property           @relation(fields: [propertyId], references: [id])
  unit         Unit?              @relation(fields: [unitId], references: [id])
  category     TicketCategory?    @relation(fields: [categoryId], references: [id])
  department   Department?        @relation(fields: [departmentId], references: [id])
  assignedTo   User?              @relation("ScheduleAssignee", fields: [assignedToId], references: [id])
  createdBy    User               @relation("ScheduleCreator", fields: [createdById], references: [id])

  @@index([nextRunAt, isActive])
  @@index([propertyId])
}

model AssetCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]
}

model Todo {
  id          String     @id @default(uuid())
  title       String
  dueDate     DateTime
  status      TodoStatus @default(OPEN)
  completedAt DateTime?
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  linkUrl   String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model DeviceToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
